{
  "App": {
    "BackendUrl": "https://localhost:59131"
  },
  "Database": {
    "Provider": "PostgreSql"
  },
  "Jwt": {
    "Issuer": "TaskManagement",
    "Audience": "TaskManagement.Client",
    "SecretKey": "DEVELOPMENT_KEY_REPLACE_IN_PRODUCTION_MIN_32_CHARACTERS_LONG!",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}