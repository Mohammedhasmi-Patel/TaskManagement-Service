
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

Database__Provider=PostgreSql


ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=taskmanagement;Username=postgres;Password=postgres

Jwt__Issuer=TaskManagement
Jwt__Audience=TaskManagement.Client
Jwt__SecretKey=REPLACE_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS_LONG!
Jwt__ExpirationMinutes=60


Cors__AllowedOrigins=https://your-taskmanagement-frontend.vercel.app

App__BackendUrl=https://your-api-domain.com

