# ==============================================================================
# Environment Configuration Template for TaskManagement API
# ==============================================================================

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Database Provider ("PostgreSql" or "SqlServer")
Database__Provider=PostgreSql

# Database Connection String
# Example PostgreSQL: Host=your-db-host;Port=5432;Database=taskmanagement;Username=postgres;Password=your_password;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=taskmanagement;Username=postgres;Password=postgres

# JWT Authentication (SecretKey MUST be at least 32 characters long)
Jwt__Issuer=TaskManagement
Jwt__Audience=TaskManagement.Client
Jwt__SecretKey=REPLACE_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS_LONG!
Jwt__ExpirationMinutes=60

# CORS - Allowed Origins (comma-separated or wildcard)
# In production, set this to your frontend URL on Vercel:
# e.g., https://your-taskmanagement-frontend.vercel.app
Cors__AllowedOrigins=https://your-taskmanagement-frontend.vercel.app

# Application URLs
App__BackendUrl=https://your-api-domain.com

